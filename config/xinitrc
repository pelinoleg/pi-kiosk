#!/bin/bash
# X session for the kiosk: no blanking, no cursor, no desktop furniture.

xset -dpms
xset s off
xset s noblank

# Force the panel on in case X started before the monitor was attached. Output
# names differ across Pi models, drivers and panel types - DSI mini screens are
# not called HDMI-anything - so try each one and stop at the first that exists.
for out in HDMI-1 HDMI-2 HDMI-A-1 HDMI-A-2 DSI-1 DSI-2 DSI-A-1; do
    xrandr --output "$out" --auto 2>/dev/null && break
done

# Pick a single output before anything draws: with a DSI panel permanently
# connected, plugging in HDMI would otherwise light both screens at once.
/usr/local/bin/kiosk-output.sh 2>/dev/null || true

unclutter -idle 5 &

# Композитор нужен часам поверх экрана: без него «полупрозрачный» фон
# превращается в сплошной чёрный ящик. Фуллскрин-окна (браузер, видео) picom
# не редиректит, так что на плавность они не жалуются.
# Именно xrender: glx-бэкенд на vc4/glamor падает (GLX_BAD_FB_CONFIG), а
# без явного бэкенда picom вообще отказывается стартовать.
command -v picom >/dev/null && picom -b --backend xrender 2>/dev/null

exec openbox-session
