# Kiosk configuration. The installer copies this to /etc/kiosk/kiosk.env and
# fills in what it can detect; edit that file, not this one.
# Everything here is optional — the defaults shown are what the code uses.

# --- Surface API -------------------------------------------------------------
# Port the control API listens on.
API_PORT=7000

# --- Display restore ---------------------------------------------------------
# Hit after boot to put the screen back to whatever it should be showing.
# May be any URL that ends up driving this box's own API; redirects are followed.
# Leave empty to skip display restore entirely.
COMBO_URL=http://192.168.1.95:8888/surface/combo

# How long to wait, in seconds, for the network and for the local API to answer
# before attempting the restore anyway.
RESTORE_WAIT_NETWORK=180
RESTORE_WAIT_API=90

# --- Network watchdog --------------------------------------------------------
# Wireless interface to nurse. Set to empty to disable the wifi-specific steps
# (useful when the box is on ethernet).
WIFI_IFACE=wlan0

# Hosts that prove the LAN is usable. The default gateway is always tried first;
# these are the fallbacks. Space separated.
PROBE_HOSTS="192.168.1.1"

# Consecutive failed checks before each escalation step.
SOFT_FAIL=2      # bounce the wireless interface
HARD_FAIL=4      # restart NetworkManager
REBOOT_FAIL=8    # reboot the machine

# Seconds of uptime before the watchdog is allowed to act at all.
BOOT_GUARD=150

# Never reboot twice inside this many seconds, so a broken network cannot turn
# into a boot loop.
REBOOT_COOLDOWN=1800
